# ==============================================================================
# KeepCheck - Environment Configuration Example
# Copy this file to `.env.local` and populate the values for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NextAuth / Auth.js (v5) - Google OAuth Authentication
# ------------------------------------------------------------------------------
# Create an OAuth 2.0 Client ID in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-oauth-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# Generated secret for session signing (run: `npx auth secret` or `openssl rand -base64 33`)
AUTH_SECRET=your-nextauth-secret-key-min-32-characters

# Local development URL
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK - Custom Token Minting (/api/firebase-token)
# ------------------------------------------------------------------------------
# Paste the full service account JSON as a single-line or valid JSON string.
# Obtained from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-firebase-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com"}

# ------------------------------------------------------------------------------
# 3. Firebase Client SDK (Cloud Firestore & Firebase Auth)
# ------------------------------------------------------------------------------
# Obtained from Firebase Console -> Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ------------------------------------------------------------------------------
# 4. Cloudinary - Image Uploads & Multi-Device Sync
# ------------------------------------------------------------------------------
# Create an unsigned upload preset in Cloudinary Console -> Settings -> Upload -> Upload presets
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# ------------------------------------------------------------------------------
# 5. CARTO Voyager Map Tiles (Optional)
# ------------------------------------------------------------------------------
# Optional CARTO API key for high-rate-limit raster tiles. If omitted, default CARTO / OSM tiles are used.
NEXT_PUBLIC_CARTO_API_KEY=

# ------------------------------------------------------------------------------
# 6. Resend REST API & Feedback Delivery (Server-only)
# ------------------------------------------------------------------------------
# API key obtained from Resend Console -> API Keys (https://resend.com/api-keys)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Destination email address where user feedback submissions will be delivered
FEEDBACK_TO_EMAIL=feedback@your-domain.com

